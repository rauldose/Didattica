{
  "name": "didattica-classe",
  "version": "1.0.0",
  "private": true,
  "description": "API della classe online (Cloudflare Worker + D1) per Impara giocando",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787 --persist-to .wrangler/state",
    "db:local": "wrangler d1 migrations apply didattica-classe --local --persist-to .wrangler/state",
    "db:remote": "wrangler d1 migrations apply didattica-classe --remote",
    "test": "node --test --test-reporter=spec test/api.test.mjs",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.151.2"
  }
}
